<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Grouping Suite">

    <!-- Smoke Test Run -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="Vinominds.SelinumProject.S2_grouping"/>
        </classes>
    </test>

    <!-- Sanity Test Run -->
    <test name="Sanity Tests">
        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>
        <classes>
            <class name="Vinominds.SelinumProject.S2_grouping"/>
        </classes>
    </test>

    <!-- Regression Test Run -->
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="Vinominds.SelinumProject.S2_grouping"/>
        </classes>
    </test>

    <!-- Custom Group Test Run -->
    <test name="Pongal Tests">
        <groups>
            <run>
                <include name="pongal"/>
            </run>
        </groups>
        <classes>
            <class name="Vinominds.SelinumProject.S2_grouping"/>
        </classes>
    </test>

</suite>